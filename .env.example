DISCORD_TOKEN=put_your_bot_token_here
DISCORD_CLIENT_ID=your_application_id
# Server IDs where slash commands should appear. Add each authorized server, separated by commas.
DISCORD_GUILD_IDS=
# Optional: exactly two server IDs for bidirectional punishment/undo sync. If omitted, the legacy behavior uses DISCORD_GUILD_IDS only when it contains exactly two IDs.
DISCORD_PUNISHMENT_GUILD_IDS=
# Optional legacy single-server setting. DISCORD_GUILD_IDS takes precedence.
DISCORD_GUILD_ID=
# Required: ID of a private text channel used to store encrypted bot state.
DISCORD_STORAGE_CHANNEL_ID=
# Required for /说话 and /管理说话: separate private text channel in the same storage server for encrypted records.
DISCORD_SPEECH_ARCHIVE_CHANNEL_ID=
# Optional one-time migration source: previous private Discord state channel ID. The old copy is not deleted.
DISCORD_LEGACY_STORAGE_CHANNEL_ID=
# Required: a secret Base64-encoded 32-byte AES-256-GCM key; keep it only in this local .env/secret manager and back it up securely.
DATA_ENCRYPTION_KEY=
# Optional: uncomment and set these only if the machine running the bot needs a proxy.
# HTTP_PROXY=http://127.0.0.1:7897
# HTTPS_PROXY=http://127.0.0.1:7897
# NO_PROXY=localhost,127.0.0.1
