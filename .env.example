DISCORD_TOKEN=put_your_bot_token_here
DISCORD_CLIENT_ID=your_application_id
# Optional: set this to your server ID for immediate slash-command updates while testing.
DISCORD_GUILD_IDS=
# Optional legacy single-server setting. DISCORD_GUILD_IDS takes precedence.
DISCORD_GUILD_ID=
API_BASE_URL=https://api.openai.com/v1
API_KEY=put_your_api_key_here
API_MODEL=gpt-4o-mini
# Optional provider-specific chat completions path (default: /chat/completions)
API_PATH=/chat/completions
# Optional: uncomment and set these only if the machine running the bot needs a proxy.
# HTTP_PROXY=http://127.0.0.1:7897
# HTTPS_PROXY=http://127.0.0.1:7897
# NO_PROXY=localhost,127.0.0.1
SYSTEM_PROMPT=You are a helpful assistant. Reply in the user's language.
MAX_HISTORY_MESSAGES=12
